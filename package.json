{
  "name": "pay402",
  "version": "0.1.0",
  "description": "Drop-in x402 (protocol v2) payment middleware for APIs — charge AI agents per-request in stablecoins via a hosted facilitator, without custodying funds.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./ledger": {
      "types": "./dist/ledger.d.ts",
      "default": "./dist/ledger.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "default": "./dist/dashboard.js"
    },
    "./mock-facilitator": {
      "types": "./dist/facilitator/mock.d.ts",
      "default": "./dist/facilitator/mock.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test",
    "example:server": "tsx examples/server-llm/index.ts",
    "example:agent": "tsx examples/agent-demo/index.ts"
  },
  "peerDependencies": {
    "@coinbase/cdp-sdk": ">=1.0.0",
    "express": ">=4.18.0"
  },
  "peerDependenciesMeta": {
    "@coinbase/cdp-sdk": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@x402/core": "2.27.0",
    "@x402/evm": "2.27.0",
    "@x402/fetch": "2.27.0",
    "eslint": "^9.0.0",
    "express": "^4.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "viem": "^2.56.9",
    "vitest": "^2.1.0"
  }
}
